# Required in Railway; never commit a real token
TELEGRAM_BOT_TOKEN=

# Required for shared multi-user audit storage. Set to Railway Redis REDIS_URL.
REDIS_URL=

# Set to your real SLD call booking page
CALL_BOOKING_URL=https://smartlivingdaily.io/call

# Optional Telegram webhook verification secret; configure same value with Telegram setWebhook
WEBHOOK_SECRET=

# Exact public origin of your website; set to your actual GitHub Pages/custom domain
ALLOWED_ORIGIN=https://yourcryptopro.github.io
